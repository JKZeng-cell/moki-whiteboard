{
  "name": "moki-whiteboard",
  "version": "0.1.7",
  "private": true,
  "author": "MOKI",
  "license": "MIT",
  "homepage": "https://github.com/JKZeng-cell/moki-whiteboard#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JKZeng-cell/moki-whiteboard.git"
  },
  "bugs": {
    "url": "https://github.com/JKZeng-cell/moki-whiteboard/issues"
  },
  "type": "module",
  "description": "MOKI 白板独立应用与 MCP Server",
  "main": "dist/desktop/main.js",
  "bin": {
    "moki-whiteboard-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/main.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:mcp:stdio": "node scripts/mcp-stdio-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/server/main.js",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:dist": "node dist/mcp/server.js",
    "desktop": "node scripts/build-whiteboard-icon.mjs && npm run build && electron .",
    "desktop:dist": "node scripts/package-desktop.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.8",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.8",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.8",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.8",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "3.18.1",
    "@extend-ai/react-pptx": "^0.1.2",
    "@fastify/static": "^10.1.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "dsh-univer-office": "0.2.10",
    "fastify": "^5.6.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.544.0",
    "parse5": "^8.0.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "unpdf": "^1.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.3.0",
    "electron-builder": "26.15.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.0"
  }
}
